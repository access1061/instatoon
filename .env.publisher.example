# Meta API (copy the version shown in your Meta app dashboard, e.g. vXX.X)
META_API_VERSION=
INSTAGRAM_USER_ID=
INSTAGRAM_ACCESS_TOKEN=
THREADS_USER_ID=me
THREADS_ACCESS_TOKEN=

# Public GitHub repository. The image must be committed and pushed before publishing.
MEDIA_PROVIDER=github
GITHUB_RAW_BASE_URL=https://raw.githubusercontent.com/access1061/instatoon/main

# Optional alternative: S3-compatible storage (requires `pip install boto3`)
# MEDIA_PROVIDER=s3
# MEDIA_BUCKET=
# MEDIA_PUBLIC_BASE_URL=https://media.example.com
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_DEFAULT_REGION=auto
# S3_ENDPOINT_URL=
